+"""Binding of replay results (adversarial review 2026-10-02): a replay result is valid only for the exact inputs it was computed
+from.  binding(script, manifest) returns (sha256, details) over
+  * every TRANSITIVE local source of the replay script (AST import closure: every module imported anywhere in a file, followed
+    recursively; this over-approximates the decision sources),
+  * every cached chart file (refcache/*), byte for byte (check_charts.py separately proves they equal the exact rebuild),
+  * the manifest file, byte for byte,
+  * the numerics environment: TM_ORDER (Taylor-model order, read by tm.py), the arb working precision, the Python version and
+    implementation, the versions of python-flint, numpy, scipy, scikit-fem, the machine architecture, and the thread-count
+    variables of the BLAS libraries.
+replay_ok.py reuses a previous replay only if its recorded binding equals the current one (and the log sha256 is unchanged)."""
+import ast, os, sys, hashlib, json, platform
+HERE = os.path.dirname(os.path.abspath(__file__))
+
+def local_imports(f):
+    t = ast.parse(open(os.path.join(HERE, f)).read())
+    out = set()
+    for n in ast.walk(t):
+        if isinstance(n, ast.Import):
+            for a in n.names: out.add(a.name.split('.')[0])
+        elif isinstance(n, ast.ImportFrom) and n.module and n.level == 0:
+            out.add(n.module.split('.')[0])
+    return sorted(m + '.py' for m in out if os.path.exists(os.path.join(HERE, m + '.py')))
+
+def closure(entries):
+    seen = set(); st = list(entries)
+    while st:
+        f = st.pop()
+        if f in seen: continue
+        seen.add(f); st.extend(local_imports(f))
+    return sorted(seen)
+
+def environment():
+    import importlib.metadata as md
+    vers = {}
+    for p in ('python-flint', 'numpy', 'scipy', 'scikit-fem'):
+        try: vers[p] = md.version(p)
+        except Exception: vers[p] = 'missing'
+    from flint import ctx
+    import tm
+    return dict(TM_ORDER=os.environ.get('TM_ORDER', '<unset>'), tm_order_effective=tm.ORDER, arb_prec=ctx.prec,
+                python=sys.version.split()[0], implementation=platform.python_implementation(), machine=platform.machine(),
+                packages=vers, threads={k: os.environ.get(k, '<unset>') for k in ('OMP_NUM_THREADS', 'OPENBLAS_NUM_THREADS',
+                                                                                   'VECLIB_MAXIMUM_THREADS', 'MKL_NUM_THREADS')})
+
+def binding(script, manifest=None):
+    h = hashlib.sha256(); det = {}
+    srcs = closure([script])
+    for f in srcs:
+        b = open(os.path.join(HERE, f), 'rb').read()
+        h.update(b'SRC'); h.update(f.encode()); h.update(hashlib.sha256(b).digest())
+    det['sources'] = {f: hashlib.sha256(open(os.path.join(HERE, f), 'rb').read()).hexdigest() for f in srcs}
+    rc = os.path.join(HERE, 'refcache')
+    det['refcache'] = {}
+    if os.path.isdir(rc):
+        for f in sorted(os.listdir(rc)):
+            hb = hashlib.sha256(open(os.path.join(rc, f), 'rb').read()).hexdigest()
+            h.update(b'CACHE'); h.update(f.encode()); h.update(hb.encode()); det['refcache'][f] = hb
+    if manifest is not None:
+        mb = hashlib.sha256(open(manifest if os.path.isabs(manifest) else os.path.join(HERE, manifest), 'rb').read()).hexdigest()
+        h.update(b'MANIFEST'); h.update(mb.encode()); det['manifest_sha256'] = mb
+    env = environment()
+    h.update(b'ENV'); h.update(json.dumps(env, sort_keys=True).encode()); det['environment'] = env
+    return h.hexdigest(), det
+
+if __name__ == '__main__':
+    hx, det = binding(sys.argv[1], sys.argv[2] if len(sys.argv) > 2 else None)
+    print(hx); print(json.dumps(dict(sources=list(det['sources']), environment=det['environment'],
+                                     manifest_sha256=det.get('manifest_sha256')), indent=1))
