+# ------------------------------------------------------------------------------------------------ helpers
+def test_helpers():
+    N = 3000 if not QUICK else 600
+    for _ in range(N):
+        x = rand_ball()
+        try:
+            d, u = fdown(x), fup(x)
+        except ng.NaNError:
