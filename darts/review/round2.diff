+            if t == 'leaf' and 'path' in d: prev[(d['root'], d['path'])] = ('leaf', d['status'])
+            elif t == 'split': prev[(d['root'], d['path'])] = ('split', int(d['dirn']), int(d['knew']))
+            elif t == 'esc': prev[(d['root'], d['path'])] = ('esc', int(d['knew']))
+            elif t == 'root_done': done[d['root']] = d
+    return prev, done
