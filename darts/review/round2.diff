+#!/bin/bash
+# Fail-closed replay of every rigorous computation of the dart proof (run from darts/).  Exit status 0 iff EVERY check passes.
+#   lemma scripts (certified tables), chart conformity, Corollary H', CBOX cover, global accounting;
+#   replay2.py for the logs of the first session (certs/) and the KF runs (certs2/);
+#   replay3.py for the cover5 family runs, re-certified with the repaired verifier (certs4/<fam>.w<ID>.jsonl from recert.py,
+#   merged by merge_pool.py --dir certs4; CERTS_DIR overrides).
+# Every replay checks: record whitelist + schemas, duplicates, completeness (no pending roots), exact tiling, re-decided discards,
+# recomputed certificates; per-record sha256 + verifier-source sha256 written to replays/*.jsonl.
+# CPU courtesy: SHARDS processes in parallel (default 2) at nice 10.  QUICK=1: structure only (no re-certification).
+# A replay of an unchanged log with unchanged verifier sources is reused (replay_ok.py); FRESH=1 forces all replays.
+cd "$(dirname "$0")"
+PY=/Users/admin/.venvs/analysis-py313/bin/python
+export OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 VECLIB_MAXIMUM_THREADS=1
+SHARDS=${SHARDS:-2}
+NR=""; [ -n "$QUICK" ] && NR="--no-recert"
+mkdir -p replays
+status=0
+run() { echo "== $*"; nice -n 10 "$@" > /tmp/darts_replay_step.log 2>&1; s=$?; grep -v CONTIG /tmp/darts_replay_step.log | tail -3; \
+        if [ $s -ne 0 ]; then echo "   FAILED (exit $s)"; status=1; fi; }
+run $PY lemma_sector.py
+run $PY lemma_longarm.py
+run $PY check_charts.py 8
+run $PY rigor_lint.py
+run $PY test_containment.py
+run $PY hull_to_box.py 56 64 0.0339 0.12 0.5 0.875
+run $PY check_cbox_cover.py
+run $PY accounting.py
+# sharded replays: replay LOG FAMILY MANIFEST SCRIPT TAG
+shard() {
+  local log=$1 fam=$2 man=$3 scr=$4 tag=$5 pids=() i
+  # reuse a previous complete replay of the same log with the same verifier sources (replay_ok.py checks both sha256)
+  if [ -z "$QUICK" ] && [ -z "$FRESH" ] && $PY replay_ok.py $tag $log $scr $man; then return; fi
+  rm -f replays/$tag.[0-9]*.jsonl replays/$tag.[0-9]*.log
+  for ((i=0; i<SHARDS; i++)); do
+    nice -n 10 $PY $scr $log $fam $man --shard $i/$SHARDS --out replays/$tag.$i.jsonl $NR > replays/$tag.$i.log 2>&1 & pids+=($!)
+  done
+  local ok=0
+  for p in "${pids[@]}"; do wait $p || ok=1; done
+  echo "== $scr $log ($fam): $(for ((i=0; i<SHARDS; i++)); do grep -h '"leaves_checked"' replays/$tag.$i.log | sed 's/.*"leaves_checked": \([0-9]*\), "ok": \([0-9]*\), "failures": \([0-9]*\).*/\1 checked \2 ok \3 failures/'; done | tr '\n' ';')"
+  [ $ok -ne 0 ] && { echo "   FAILED"; status=1; }
+}
+shard certs/crit_collar.jsonl   COLLAR    manifests/crit_collar.json   replay2.py crit_collar
+shard certs/crit_spike_X1.jsonl SPIKE_X1  manifests/crit_spike_X1.json replay2.py crit_spike_X1
+shard certs/main_cbox.jsonl     MAIN_CBOX manifests/main_cbox.json     replay2.py main_cbox
+shard certs/shallow_crit.jsonl  BOX       manifests/shallow_crit.json  replay2.py shallow_crit
+shard certs2/kf_collar.jsonl    KF_COLLAR manifests/kf_collar.json     replay2.py kf_collar
+shard certs2/kf_spike.jsonl     KF_SPIKE  manifests/kf_spike.json      replay2.py kf_spike
+CERTS=${CERTS_DIR:-certs4}
+for F in PP SP_col SP_spk PF FP FF SF_col SF_spk; do
+  L=$(echo $F | tr A-Z a-z)
+  # merge the static shard logs certs3/<fam>.<i>.jsonl and the pool worker logs certs3/<fam>.w<ID>.jsonl (merge_pool.py fails
+  # if a root has records in two files or two root_done records); completeness etc. are then checked by replay3.py
+  [ -n "$L" ] && [ -n "$CERTS" ] && rm -f "$CERTS/$L.merged.jsonl"          # never replay a stale merge
+  run $PY merge_pool.py $F --dir $CERTS
+  if [ ! -f $CERTS/$L.merged.jsonl ]; then echo "== $F: log $CERTS/$L.merged.jsonl MISSING"; status=1; continue; fi
+  shard $CERTS/$L.merged.jsonl $F manifests/$L.json replay3.py $L
+done
+echo "REPLAY_ALL STATUS: $([ $status -eq 0 ] && echo PASS || echo FAIL)"
+exit $status
--- a/recert_all.sh
+++ b/recert_all.sh
@@ -0,0 +1,17 @@
+#!/bin/bash
+# Re-certification of all cover5 family trees with the repaired verifier (recert.py): N workers (default 7) at nice 10, each
+# working through the families in a fixed order (largest first); a root is claimed by exactly one worker
+# (certs4/claims/<fam>/<root>); rerunning this script resumes (claims and per-worker outputs are kept).
+# Output: certs4/<fam>.w<ID>.jsonl; progress: certs4/recert.w<ID>.out.  Afterwards: SHARDS=7 FRESH=1 ./replay_all.sh
+cd "$(dirname "$0")"
+PY=/Users/admin/.venvs/analysis-py313/bin/python
+N=${1:-7}
+export OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 VECLIB_MAXIMUM_THREADS=1
+mkdir -p certs4
+for F in PP SP_spk SP_col FP PF FF SF_spk SF_col; do $PY recert.py --split $F > /dev/null || exit 1; done
+for ((w=1; w<=N; w++)); do
+  ( for F in PP SP_spk SP_col FP PF FF SF_spk SF_col; do
+      nice -n 10 $PY recert.py $F $w >> certs4/recert.w$w.out 2>> certs4/recert.w$w.err || echo "worker $w family $F exit $?" >> certs4/recert.w$w.err
+    done; echo "ALLDONE $(date '+%F %T')" >> certs4/recert.w$w.out ) &
+done
+wait
