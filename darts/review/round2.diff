+        elif r < 0.6: c.append(arb(rng.uniform(-3, 3), 10**rng.uniform(-30, -5)))
+        elif r < 0.7: c.append(arb(rng.uniform(-1e6, 1e6), 10**rng.uniform(0, 6)))   # huge radius
