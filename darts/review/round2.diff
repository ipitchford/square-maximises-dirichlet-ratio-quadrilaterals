+        if x0[k + 1] - x[-1] > tol or k == len(V0) - 1:
+            if x0[k + 1] - x[-1] > tol: x.append(x0[k + 1]); V.append(vmax)
+            else: V[-1] = max(V[-1], vmax) if V else vmax; x[-1] = x0[k + 1] if not V else x[-1]
