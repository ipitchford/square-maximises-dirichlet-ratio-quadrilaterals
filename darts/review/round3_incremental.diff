+"""Markdown table of a proof replay from its aggregate receipt (replays/receipts/<ID>.jsonl, written by replay_all.py): for
+every run (log): family, log sha256 prefix, shards, leaves checked / ok / failures (from the shard summaries recorded in the
+receipt), validation problems; then the gate results and the final status.  The receipt's hash chain is verified first.
+Usage: summarize.py RECEIPT"""
+import sys, json, hashlib
+def main():
+    raw = open(sys.argv[1], 'rb').read().split(b'\n')
+    if raw and raw[-1] == b'': raw = raw[:-1]
+    prev = '0'*64; recs = []
+    for line in raw:
+        d = json.loads(line)
+        if d['prev_sha256'] != prev: print('RECEIPT HASH CHAIN BROKEN at seq', d.get('seq')); sys.exit(1)
+        prev = hashlib.sha256(line + b'\n').hexdigest(); recs.append(d)
+    start = recs[0]['data']; end = recs[-1]['data'] if recs[-1]['kind'] == 'end' else None
+    print(f"run {start['run_id']} mode {start['mode']} shards {start['shards']} pin {start['pin_file']} ({start['pin_count']} files)")
+    print('| log | family | log sha256 | shards ok | leaves checked | ok | failures | validation problems |')
+    print('|---|---|---|---|---|---|---|---|')
+    for r in recs:
+        if r['kind'] != 'replay': continue
+        d = r['data']; s = [x for x in d['summaries'] if x]
+        ok_sh = sum(1 for c in d['exit_codes'].values() if c == 0)
+        print(f"| `{d['log']}` | {d['family']} | {d['log_sha256'][:12]} | {ok_sh}/{d['shards']} | {sum(x['leaves_checked'] for x in s)} | "
+              f"{sum(x['ok'] for x in s)} | {sum(x['failures'] for x in s)} | {d['validation_problems']} |")
+    for r in recs:
+        if r['kind'] == 'gate': print(f"gate {' '.join(r['data']['command'])}: exit {r['data']['exit']}")
+    print('end:', json.dumps(end) if end else 'NO END RECORD (incomplete run)')
+if __name__ == '__main__':
+    main()
