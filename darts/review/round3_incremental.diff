+    try: pins = read_pin(a.pin)                                         # before anything is created
+    except (OSError, SystemExit) as e: raise SystemExit(f'pin file {a.pin!r} unreadable or malformed: {e}')
+    if not pins: raise SystemExit(f'pin file {a.pin!r} is empty')
+    run_id = a.run_id or (time.strftime('%Y%m%dT%H%M%S') + '_' + secrets.token_hex(4))
+    if not re.fullmatch(r'[A-Za-z0-9_.-]+', run_id): raise SystemExit('bad run id')
+    base = os.path.join(HERE, 'replays') if a.mode != 'test' else os.path.join(HERE, 'replays', 'test_runs')
+    run_dir = os.path.join(base, f'run_{run_id}')
+    os.makedirs(run_dir, exist_ok=False)                                   # never reuse or overwrite a run directory
+    rc_ = Receipt(os.path.join(base, 'receipts', f'{run_id}.jsonl'))
+    import fpenv, replay_common as rcm
+    from binding import binding, runtime_identity, closure
+    from replay_ok import validate
+    failures = []
+    def failed(stage, msg):
